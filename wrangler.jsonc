{
    "$schema": "node_modules/wrangler/config-schema.json",
    "name": "kmx-webbsida",
    "main": "worker.js",
    "compatibility_date": "2026-07-29",
    "assets": {
        "directory": ".",
        "binding": "ASSETS",
        "not_found_handling": "404-page",
        "exclude": [
            "functions/**",
            "worker.js",
            "wrangler.jsonc"
        ]
    }
}
